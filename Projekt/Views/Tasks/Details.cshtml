@model HomeworkTask
@{
    ViewData["Title"] = "Szczegóły zadania";
    var isOverdue = Model.Deadline < DateTime.Today && Model.Status != TodoStatus.Done;
}

<div class="form-page">
    <div class="form-header">
        <a href="/Tasks" class="back-link">← Wróć do listy</a>
        <h1>📄 Szczegóły zadania</h1>
    </div>

    <div class="form-card details-card">
        <div class="detail-row">
            <span class="detail-label">Opis</span>
            <span class="detail-value big">@Model.Description</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Termin</span>
            <span class="detail-value @(isOverdue ? "text-danger" : "")">
                @Model.Deadline.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("pl-PL"))
                @if (isOverdue) { <strong>(PRZETERMINOWANE)</strong> }
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Status</span>
            <span class="status-badge @Model.Status.ToString().ToLower()">
                @(Model.Status switch {
                    TodoStatus.ToDo => "⏳ Do zrobienia",
                    TodoStatus.InProgress => "🔄 W trakcie",
                    TodoStatus.Done => "✅ Zrobione",
                    _ => Model.Status.ToString()
                })
            </span>
        </div>

        <div class="form-actions">
            <a href="/Tasks/Edit/@Model.Id" class="btn btn-secondary">✏️ Edytuj</a>
            <form method="post" action="/Tasks/Delete/@Model.Id" onsubmit="return confirm('Usunąć to zadanie?')" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">🗑️ Usuń</button>
            </form>
        </div>
    </div>
</div>
